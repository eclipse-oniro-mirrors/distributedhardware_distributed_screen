#####################hydra-fuzz###################
import("//build/config/features.gni")
import("//build/test.gni")
import("//foundation/distributedhardware/distributed_screen/distributedscreen.gni")

##############################fuzztest##########################################
ohos_fuzztest("ScreenDecisionCenterFuzzTest") {
  module_out_path = "${fuzz_test_path}/common"

  include_dirs = [
    "${common_path}/include",
    "${services_path}/common/databuffer/include",
    "${services_path}/common/decision_center/include",
    "${services_path}/common/imageJpeg/include",
    "${services_path}/common/screen_channel/include",
    "${services_path}/common/utils/include",
    "${services_path}/screentransport/screensourceprocessor/include",
    "${services_path}/screentransport/screensourceprocessor/encoder/include",
    "${services_path}/screentransport/screensourcetrans/include",
  ]

  fuzz_config_file = "${distributedscreen_path}/test/fuzztest/screendecisioncenter_fuzzer"

  cflags = [
    "-g",
    "-O0",
    "-Wno-unused-variable",
    "-fno-omit-frame-pointer",
    "-Wno-c99-designator",
  ]

  sources = [
    "screendecisioncenter_fuzzer.cpp",
  ]

  deps = [
    "${services_path}/screentransport/screensourcetrans:distributed_screen_sourcetrans",
  ]

  external_deps = [
    "av_codec:av_codec_client",
    "c_utils:utils",
    "graphic_surface:surface",
    "graphic_surface:sync_fence",
    "hilog:libhilog",
    "ipc:ipc_single",
    "json:nlohmann_json_static",
    "media_foundation:media_foundation",
  ]

  defines = [
    "HI_LOG_ENABLE",
    "DH_LOG_TAG=\"ScreenDecisionCenterFuzzTest\"",
    "LOG_DOMAIN=0xD004140",
  ]
}

###############################################################################
group("fuzztest") {
  testonly = true
  deps = []
  deps += [
    # deps file
    ":ScreenDecisionCenterFuzzTest",
  ]
}
###############################################################################
