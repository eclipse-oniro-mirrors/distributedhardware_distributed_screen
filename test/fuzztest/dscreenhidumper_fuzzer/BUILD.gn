#####################hydra-fuzz###################
import("//build/config/features.gni")
import("//build/test.gni")
import("//foundation/distributedhardware/distributed_screen/distributedscreen.gni")

##############################fuzztest##########################################
ohos_fuzztest("DScreenHidumperFuzzTest") {
  module_out_path = "${fuzz_test_path}/common"

  include_dirs = [
    "${common_path}/include",
    "${services_path}/common/utils/include",
  ]

  fuzz_config_file = "${distributedscreen_path}/test/fuzztest/dscreenhidumper_fuzzer"

  cflags = [
    "-g",
    "-O0",
    "-Wno-unused-variable",
    "-fno-omit-frame-pointer",
    "-Wno-c99-designator",
  ]

  sources = [
    "${common_path}/src/dscreen_util.cpp",
    "${services_path}/common/utils/src/dscreen_hidumper.cpp",
    "dscreenhidumper_fuzzer.cpp",
  ]

  deps = []

  external_deps = [
    "distributed_hardware_fwk:distributedhardwareutils",
    "dsoftbus:softbus_client",
    "hilog:libhilog",
    "init:libbegetutil",
  ]

  defines = [
    "HI_LOG_ENABLE",
    "DH_LOG_TAG=\"DScreenHidumperFuzzTest\"",
    "LOG_DOMAIN=0xD004140",
  ]
}

###############################################################################
group("fuzztest") {
  testonly = true
  deps = []
  deps += [
    # deps file
    ":DScreenHidumperFuzzTest",
  ]
}
###############################################################################
